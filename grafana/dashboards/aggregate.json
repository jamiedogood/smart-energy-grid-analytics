    {
      "id": 5,
      "type": "table",
      "title": "P5 - Completeness by region (%)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "-- panel: P5 (agg)\nWITH reg AS (SELECT region, count(*) AS meters FROM meters GROUP BY region),\n     obs AS (SELECT region, sum(reading_count) AS observed\n             FROM energy_15m_region\n             WHERE bucket >= $__timeFrom() AND bucket < $__timeTo()\n             GROUP BY region)\nSELECT reg.region,\n       (100.0 * coalesce(obs.observed, 0) / (reg.meters * (extract(epoch FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) / 900)))::double precision AS completeness_pct,\n       coalesce(obs.observed, 0)::bigint AS readings,\n       (reg.meters * (extract(epoch FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) / 900))::bigint AS planned\nFROM reg LEFT JOIN obs USING (region)\nORDER BY substring(reg.region FROM 8)::int"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 4
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "readings"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "planned"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
