# Copy this file to .env and fill in real values.
# .env is read automatically by `docker compose` and must NEVER be committed (.gitignore excludes it).
# This .env.example IS committed, so the README can tell others which variables to set.

# PostgreSQL superuser password (used by the timescaledb, app and grafana containers)
PG_PASSWORD=<your-postgres-password>

# Name of the assignment database
PG_DATABASE=smartgrid

# EMQX web dashboard login (user: admin). Only applied the first time EMQX starts with an empty data volume.
EMQX_DASHBOARD_PASSWORD=<your-emqx-dashboard-password>

# Grafana login (user: admin). Only applied the first time Grafana starts with an empty data volume.
GRAFANA_ADMIN_PASSWORD=<your-grafana-admin-password>
